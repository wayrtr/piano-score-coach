# Optional local settings. Copy to .env.local and uncomment only what you need.
# Current MusicXML/MXL and Audiveris import flows require no API key.
# Never put real credentials in this example or commit .env.local.

AUDIVERIS_TIMEOUT_MS=600000
# AUDIVERIS_COMMAND=/Applications/Audiveris.app/Contents/MacOS/Audiveris
# PIANO_COACH_STORAGE_DIR=<your-storage-directory>

# Launcher-only settings must be exported in your shell, not just .env.local:
# export PIANO_COACH_PORT=3000
# export PIANO_COACH_IDLE_TIMEOUT_SECONDS=900
# export TESSDATA_PREFIX=<your-ocr-model-directory>
